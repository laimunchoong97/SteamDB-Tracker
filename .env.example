# === Browser Configuration ===

# Option 1: Use a specific browser channel (works for default installations of Chrome or Edge)
# Accepted values: 'chrome', 'msedge'
BROWSER_CHANNEL=msedge

# Option 2: Provide the exact path to your preferred browser executable (e.g., Brave, Opera, custom Chrome)
# If this is set, it overrides BROWSER_CHANNEL.
# Example for Brave on Windows: C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# Example for Brave on Mac: /Applications/Brave Browser.app/Contents/MacOS/Brave Browser
BROWSER_EXECUTABLE_PATH=

# Only games at or above this latest follower count are shown in Excel and enriched via Steam API.
# The Current Outlook framework enforces a minimum value of 1000.
FOCUSED_THRESHOLD=1000

# Workbook language: en, zh-CN, or both.
# Fixed workbook text is translated; crawled game values are never translated.
OUTPUT_LANGUAGE=both

# Maximum time allowed for each Steam Store metadata request before retrying.
STEAM_API_TIMEOUT_MS=15000

# Metadata requests run concurrently but are globally spaced to reduce rate limiting.
STEAM_API_CONCURRENCY=3
STEAM_API_REQUEST_SPACING_MS=500
